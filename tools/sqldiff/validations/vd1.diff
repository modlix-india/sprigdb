# A validation against BEFORE INSERT/UPDATE triggers that SIGNAL: every form of write.
both: CREATE TABLE orders (id INT PRIMARY KEY, product_id INT, qty INT NOT NULL, note VARCHAR(32))
both: CREATE TABLE items (id INT PRIMARY KEY, qty INT)
both: CREATE TABLE audit (id INT AUTO_INCREMENT PRIMARY KEY, what VARCHAR(64))
sprig: CREATE VALIDATION qty_positive ON orders FOR INSERT, UPDATE LANGUAGE javascript AS $$ export default function (qty) { if (qty <= 0) sprig.reject('qty must be positive'); } $$
oracle: CREATE TRIGGER qp_i BEFORE INSERT ON orders FOR EACH ROW BEGIN IF NEW.qty <= 0 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'qty must be positive'; END IF; END
oracle: CREATE TRIGGER qp_u BEFORE UPDATE ON orders FOR EACH ROW BEGIN IF NEW.qty <= 0 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'qty must be positive'; END IF; END
both: CREATE TRIGGER au AFTER INSERT ON orders FOR EACH ROW INSERT INTO audit (what) VALUES (CONCAT('ins ', NEW.id))
both: INSERT INTO orders VALUES (1, 7, 3, NULL)
both: INSERT INTO orders VALUES (2, 7, 0, NULL)
both: INSERT INTO orders VALUES (3, 7, 1, NULL), (4, 7, -1, NULL), (5, 7, 2, NULL)
