# Order: SQL BEFORE triggers first, then the validation (the server: the SIGNAL trigger created after the others).
both: CREATE TABLE t (id INT PRIMARY KEY, qty INT, flag INT DEFAULT 0)
both: CREATE TRIGGER t_abs BEFORE INSERT ON t FOR EACH ROW SET NEW.qty = ABS(NEW.qty)
both: CREATE TRIGGER t_zero BEFORE UPDATE ON t FOR EACH ROW BEGIN IF NEW.flag = 1 THEN SET NEW.qty = 0; END IF; END
sprig: CREATE VALIDATION v ON t FOR INSERT, UPDATE LANGUAGE lua AS $$ if ctx.row.qty <= 0 then sprig.reject('qty must be positive') end $$
oracle: CREATE TRIGGER v_i BEFORE INSERT ON t FOR EACH ROW BEGIN IF NEW.qty <= 0 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'qty must be positive'; END IF; END
oracle: CREATE TRIGGER v_u BEFORE UPDATE ON t FOR EACH ROW BEGIN IF NEW.qty <= 0 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'qty must be positive'; END IF; END
both: INSERT INTO t (id, qty) VALUES (1, -4)
both: INSERT INTO t (id, qty) VALUES (2, 0)
both: INSERT INTO t (id, qty) VALUES (3, 5)
both: UPDATE t SET flag = 1 WHERE id = 3
both: UPDATE t SET qty = -1 WHERE id = 3
both: UPDATE t SET qty = qty + 1
check: SELECT * FROM t ORDER BY id
