# MariaDB: expressions as EXECUTE arguments, EXECUTE IMMEDIATE.
x:DROP TABLE IF EXISTS sp_m
q:CREATE TABLE sp_m (id INT PRIMARY KEY, v VARCHAR(10))
q:INSERT INTO sp_m VALUES (1,'a'),(2,'b')
q:PREPARE s FROM 'SELECT v FROM sp_m WHERE id = ?'
q:EXECUTE s USING 1
q:EXECUTE s USING 1 + 1
q:EXECUTE IMMEDIATE 'SELECT COUNT(*) FROM sp_m WHERE id >= ?' USING 1
q:EXECUTE IMMEDIATE 'INSERT INTO sp_m VALUES (?, ?)' USING 3, 'c'
q:SELECT * FROM sp_m ORDER BY id
q:EXECUTE IMMEDIATE 'SELECT ? + 1' USING 5
x:DROP TABLE IF EXISTS sp_m
