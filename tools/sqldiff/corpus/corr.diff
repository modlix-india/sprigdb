q:SELECT id FROM cq_o o WHERE NOT EXISTS (SELECT 1 FROM cq_o p WHERE p.cid = o.cid AND p.amount > o.amount) ORDER BY id
q:SELECT id FROM cq_o o WHERE EXISTS (SELECT 1 FROM cq_c c WHERE c.id = o.cid AND o.amount > c.lim) ORDER BY id
q:SELECT id FROM cq_c c WHERE EXISTS (SELECT 1 FROM cq_o o WHERE o.cid = c.id AND o.amount BETWEEN c.lim / 2 AND c.lim) ORDER BY id
