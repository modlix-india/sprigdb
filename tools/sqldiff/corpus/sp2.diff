x:CREATE TABLE sh_t (id INT PRIMARY KEY, v VARCHAR(20), n INT)
x:INSERT INTO sh_t VALUES (1, 'one', 10), (2, 'two', 20), (3, 'three', 30)
q:CREATE FUNCTION sf_a(s CHAR(20)) RETURNS VARCHAR(50) DETERMINISTIC RETURN CONCAT('Hello, ', s, '!')
q:SELECT sf_a('world')
q:SELECT sf_a(v) FROM sh_t ORDER BY id
q:SELECT id, sf_a(v) AS g FROM sh_t WHERE sf_a(v) LIKE '%o!' ORDER BY id
q:CREATE FUNCTION sf_b(a INT, b INT) RETURNS INT BEGIN DECLARE r INT; IF a > b THEN SET r = a - b; ELSE SET r = b - a; END IF; RETURN r; END
q:SELECT sf_b(3, 10), sf_b(10, 3), sf_b(NULL, 1)
q:SET @x = sf_b(5, 7)
q:SELECT @x
q:CREATE FUNCTION sf_c(k INT) RETURNS VARCHAR(20) READS SQL DATA BEGIN DECLARE r VARCHAR(20) DEFAULT 'none'; SELECT v INTO r FROM sh_t WHERE id = k; RETURN r; END
q:SELECT sf_c(2), sf_c(9)
q:SELECT sf_a(sf_c(1))
q:SELECT nosuchfn(1)
q:CREATE PROCEDURE sh_a() BEGIN DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SELECT 'caught' AS h; INSERT INTO sh_t VALUES (1, 'dup', 0); SELECT 'after' AS a; END
q:CALL sh_a()
q:CREATE PROCEDURE sh_b() BEGIN DECLARE EXIT HANDLER FOR 1062 BEGIN GET DIAGNOSTICS CONDITION 1 @st = RETURNED_SQLSTATE, @msg = MESSAGE_TEXT, @no = MYSQL_ERRNO; SELECT 'exit' AS h; END; INSERT INTO sh_t VALUES (2, 'dup', 0); SELECT 'not reached'; END
q:CALL sh_b()
q:SELECT @st, @msg, @no
q:CREATE PROCEDURE sh_c(OUT total INT) BEGIN DECLARE done INT DEFAULT 0; DECLARE x INT; DECLARE c CURSOR FOR SELECT n FROM sh_t ORDER BY id; DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = 1; SET total = 0; OPEN c; rd: LOOP FETCH c INTO x; IF done THEN LEAVE rd; END IF; SET total = total + x; END LOOP; CLOSE c; END
q:CALL sh_c(@t)
q:SELECT @t
q:CREATE PROCEDURE sh_d(k INT) BEGIN IF k < 0 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'negative', MYSQL_ERRNO = 1644; END IF; SELECT k; END
q:CALL sh_d(1)
q:CALL sh_d(-1)
q:CREATE PROCEDURE sh_e() BEGIN DECLARE x INT; DECLARE CONTINUE HANDLER FOR SQLSTATE '45000' BEGIN GET STACKED DIAGNOSTICS CONDITION 1 @m = MESSAGE_TEXT; SELECT 'handled', @m; END; SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'boom'; SELECT 'resumed'; SELECT v INTO x FROM sh_t WHERE id = 99; GET DIAGNOSTICS @cnt = NUMBER; SELECT @cnt; END
q:CALL sh_e()
q:CREATE PROCEDURE sh_f() BEGIN DECLARE c CURSOR FOR SELECT 1; OPEN c; OPEN c; END
q:CALL sh_f()
