q:CREATE PROCEDURE IF NOT EXISTS sp_a() BEGIN END
q:CREATE PROCEDURE sp_b(n INT) BEGIN DECLARE i INT DEFAULT 0; DECLARE s INT DEFAULT 0; WHILE i < n DO SET i = i + 1; SET s = s + i; END WHILE; SELECT i, s; END
q:CALL sp_b(10)
q:CALL sp_b(0)
q:CALL sp_b(NULL)
q:CREATE PROCEDURE sp_c(k INT) BEGIN DECLARE nm VARCHAR(20); DECLARE amt DECIMAL(8,2); SELECT v, n INTO nm, amt FROM sp_t WHERE id = k; IF nm IS NULL THEN SELECT 'none' AS r; ELSEIF amt IS NULL THEN SELECT nm, 'no amount' AS r; ELSE SELECT nm, amt * 2 AS dbl; END IF; END
q:CALL sp_c(1)
q:CALL sp_c(3)
q:CALL sp_c(9)
q:CREATE PROCEDURE sp_d(k INT) BEGIN CASE k WHEN 1 THEN SELECT 'one'; WHEN 2 THEN SELECT 'two'; ELSE SELECT 'many'; END CASE; CASE WHEN k > 5 THEN SELECT 'big'; WHEN k > 1 THEN SELECT 'mid'; END CASE; END
q:CALL sp_d(1)
q:CALL sp_d(7)
q:CALL sp_d(2)
q:CREATE PROCEDURE sp_e() BEGIN DECLARE i INT DEFAULT 0; l: LOOP SET i = i + 1; IF i < 3 THEN ITERATE l; END IF; IF i >= 5 THEN LEAVE l; END IF; INSERT INTO sp_t VALUES (i * 10, CONCAT('row', i), i); END LOOP l; REPEAT SET i = i - 1; UNTIL i <= 2 END REPEAT; SELECT i; SELECT id, v, n FROM sp_t ORDER BY id; END
q:CALL sp_e()
q:CREATE PROCEDURE sp_f(OUT total DECIMAL(10,2), OUT cnt INT) BEGIN SELECT SUM(n), COUNT(*) INTO total, cnt FROM sp_t; UPDATE sp_t SET n = n + 1 WHERE id > 10; DELETE FROM sp_t WHERE id = 40; END
q:CALL sp_f(@t, @n)
