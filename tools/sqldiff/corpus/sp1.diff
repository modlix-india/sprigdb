q:CREATE PROCEDURE sp_a(IN a INT, OUT b INT, INOUT c VARCHAR(10)) BEGIN DECLARE x INT DEFAULT a * 2; SELECT x, a, c; SET b = x + 1; SET c = CONCAT(c, '!'); SELECT 'two' AS t; END
q:SET @b = 0, @c = 'q'
