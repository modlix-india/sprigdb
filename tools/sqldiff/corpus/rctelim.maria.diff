# WITH RECURSIVE limits and errors, MariaDB's.
q:WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM c WHERE n<2000) SELECT COUNT(*) FROM c
q:SHOW WARNINGS
q:SET @@max_recursive_iterations = 5
q:WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT n+1 FROM c WHERE n<20) SELECT COUNT(*) FROM c
q:SET @@max_recursive_iterations = 0
q:WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM c WHERE n<3) SELECT COUNT(*) FROM c
q:SELECT @@max_recursive_iterations
q:SET @@max_recursive_iterations = DEFAULT
q:SELECT @@max_recursive_iterations
q:WITH RECURSIVE c(n) AS (SELECT 1 FROM c UNION ALL SELECT 1) SELECT COUNT(*) FROM c
q:WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM c WHERE n<3 UNION ALL SELECT n+10 FROM c WHERE n<3) SELECT * FROM c
q:WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM (SELECT * FROM c) d WHERE n<3) SELECT * FROM c
q:WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM c WHERE n<3 UNION DISTINCT SELECT 5) SELECT * FROM c
q:WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM c LIMIT 3) SELECT * FROM c
q:WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT x.n+1 FROM (SELECT 1 AS k) z LEFT JOIN c x ON 1 WHERE x.n<3) SELECT * FROM c
q:WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT 'x' FROM c WHERE n<3) SELECT * FROM c
