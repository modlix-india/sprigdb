q:CREATE PROCEDURE pc_a(IN lo INT, IN s VARCHAR(20)) BEGIN SELECT id, v, d, x FROM pc_t WHERE id >= lo ORDER BY id; SELECT CONCAT(s, '!') AS s, lo * 2 AS n; END
q:CREATE PROCEDURE pc_b(IN k INT, OUT o VARCHAR(20)) BEGIN SELECT v INTO o FROM pc_t WHERE id = k; END
