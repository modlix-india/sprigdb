# information_schema.SCHEMATA lists engine databases (migration tools check a schema exists this way).
q:SELECT SCHEMA_NAME, DEFAULT_CHARACTER_SET_NAME, DEFAULT_COLLATION_NAME FROM information_schema.SCHEMATA WHERE SCHEMA_NAME = 'rg_a'
q:SELECT * FROM information_schema.SCHEMATA WHERE SCHEMA_NAME = 'rg_a'
q:SELECT COUNT(*) FROM information_schema.SCHEMATA WHERE SCHEMA_NAME IN ('rg_a', 'rg_b')
q:SELECT SCHEMA_NAME FROM information_schema.SCHEMATA WHERE SCHEMA_NAME = 'rg_nosuch'
q:SELECT SCHEMA_NAME FROM information_schema.schemata WHERE schema_name = DATABASE()
q:SELECT CATALOG_NAME, SQL_PATH FROM information_schema.SCHEMATA WHERE SCHEMA_NAME = 'information_schema'
