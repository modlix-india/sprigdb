# LOAD DATA LOCAL INFILE into engine tables (MariaDB; the MySQL oracle has local_infile off). Files in tools/infile.
x:DROP TABLE IF EXISTS ld_t
q:CREATE TABLE ld_t (id INT PRIMARY KEY, name VARCHAR(10), amt DECIMAL(6,2))
q:LOAD DATA LOCAL INFILE 'ld1.tsv' INTO TABLE ld_t
q:SHOW WARNINGS
q:SELECT * FROM ld_t ORDER BY id
q:DELETE FROM ld_t
q:LOAD DATA LOCAL INFILE 'ld2.csv' INTO TABLE ld_t FIELDS TERMINATED BY ',' OPTIONALLY ENCLOSED BY '"' IGNORE 1 LINES
q:SHOW WARNINGS
q:SELECT * FROM ld_t ORDER BY id
q:DELETE FROM ld_t
q:LOAD DATA LOCAL INFILE 'ld3.txt' INTO TABLE ld_t FIELDS TERMINATED BY ';' ENCLOSED BY '"' LINES TERMINATED BY '\r\n' IGNORE 1 ROWS (id, name, @a) SET amt = @a * 2
q:SHOW WARNINGS
q:SELECT * FROM ld_t ORDER BY id
q:LOAD DATA LOCAL INFILE 'ld3.txt' REPLACE INTO TABLE ld_t FIELDS TERMINATED BY ';' ENCLOSED BY '"' LINES TERMINATED BY '\r\n' IGNORE 1 LINES (id, name)
q:SELECT * FROM ld_t ORDER BY id
q:DELETE FROM ld_t
q:LOAD DATA LOCAL INFILE 'ld4.txt' INTO TABLE ld_t FIELDS TERMINATED BY ',' LINES STARTING BY 'xx' (id, name, amt)
q:SELECT * FROM ld_t ORDER BY id
q:DELETE FROM ld_t
q:LOAD DATA LOCAL INFILE 'ld5.tsv' INTO TABLE ld_t
q:SHOW WARNINGS
q:SELECT COUNT(*), SUM(amt), MIN(id), MAX(id) FROM ld_t
q:LOAD DATA INFILE '/etc/hosts' INTO TABLE ld_t
q:LOAD DATA LOCAL INFILE 'ld1.tsv' INTO TABLE ld_nope
x:DROP TABLE IF EXISTS ld_t
