# Window functions on engine tables: ranking, offsets, values, aggregates over frames, named windows,
# windows over grouped rows, ORDER BY a window value, errors per server.
x:DROP TABLE IF EXISTS wf_a
x:CREATE TABLE wf_a (id INT PRIMARY KEY, g VARCHAR(5), v INT, d DECIMAL(6,2), s VARCHAR(10))
