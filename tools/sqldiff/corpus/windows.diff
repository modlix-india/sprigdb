q:SELECT id, ROW_NUMBER() OVER (ORDER BY id) rn FROM wf_a ORDER BY id
q:SELECT id, g, ROW_NUMBER() OVER (PARTITION BY g ORDER BY v, id) rn, RANK() OVER (PARTITION BY g ORDER BY v) rk, DENSE_RANK() OVER (PARTITION BY g ORDER BY v) dr FROM wf_a ORDER BY id
q:SELECT id, PERCENT_RANK() OVER (ORDER BY v) pr, CUME_DIST() OVER (ORDER BY v) cd, NTILE(3) OVER (ORDER BY id) nt FROM wf_a ORDER BY id
q:SELECT id, LAG(v) OVER (ORDER BY id) l1, LAG(v, 2) OVER (ORDER BY id) l2, LEAD(v) OVER (ORDER BY id) n1, LEAD(s, 3) OVER (PARTITION BY g ORDER BY id) n3 FROM wf_a ORDER BY id
@mysql q:SELECT id, LAG(v, 1, -1) OVER (ORDER BY id) l, LEAD(s, 1, 'none') OVER (ORDER BY id) n FROM wf_a ORDER BY id
