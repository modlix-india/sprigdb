q:SELECT id, LAST_VALUE(v) OVER (PARTITION BY g ORDER BY id ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) l FROM wf_a ORDER BY id
q:SELECT id, SUM(v) OVER (PARTITION BY g ORDER BY id) s, COUNT(*) OVER (PARTITION BY g) c, AVG(d) OVER (PARTITION BY g) a, MIN(v) OVER () mn, MAX(d) OVER (ORDER BY v) mx FROM wf_a ORDER BY id
