q:SELECT msg FROM tr_log ORDER BY k
q:CREATE TRIGGER tr_ai2 AFTER INSERT ON tr_t FOR EACH ROW FOLLOWS tr_ai SET @order = CONCAT(IFNULL(@order, ''), 'b')
q:CREATE TRIGGER tr_ai0 AFTER INSERT ON tr_t FOR EACH ROW PRECEDES tr_ai SET @order = CONCAT(IFNULL(@order, ''), 'a')
q:SET @order = ''
q:INSERT INTO tr_t (v) VALUES ('z')
q:SELECT @order
q:CREATE TRIGGER tr_x AFTER INSERT ON tr_t FOR EACH ROW FOLLOWS nosuch SET @q = 1
q:CREATE TRIGGER tr_bi BEFORE INSERT ON tr_t FOR EACH ROW SET @q = 1
