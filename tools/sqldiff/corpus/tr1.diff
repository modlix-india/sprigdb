# SQL triggers on engine databases: CREATE / DROP TRIGGER, firing per row, NEW / OLD, BEFORE changes, order, errors and rollback.
x:DROP TABLE IF EXISTS tr_t
x:DROP TABLE IF EXISTS tr_log
x:CREATE TABLE tr_t (id INT AUTO_INCREMENT PRIMARY KEY, v VARCHAR(20), n INT NOT NULL DEFAULT 5)
x:CREATE TABLE tr_log (k INT AUTO_INCREMENT PRIMARY KEY, msg VARCHAR(100))
q:CREATE TRIGGER tr_bi BEFORE INSERT ON tr_t FOR EACH ROW SET NEW.v = UPPER(NEW.v), NEW.n = NEW.n * 10
q:CREATE TRIGGER tr_ai AFTER INSERT ON tr_t FOR EACH ROW INSERT INTO tr_log (msg) VALUES (CONCAT('ins ', NEW.id, ' ', NEW.v, ' ', NEW.n))
q:INSERT INTO tr_t (v) VALUES ('a'), ('b')
q:INSERT INTO tr_t (v, n) VALUES ('c', 7)
q:SELECT * FROM tr_t ORDER BY id
q:SELECT msg FROM tr_log ORDER BY k
q:CREATE TRIGGER tr_bu BEFORE UPDATE ON tr_t FOR EACH ROW BEGIN IF NEW.n < 0 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'negative'; END IF; SET NEW.v = CONCAT(OLD.v, '>', NEW.v); END
q:CREATE TRIGGER tr_au AFTER UPDATE ON tr_t FOR EACH ROW INSERT INTO tr_log (msg) VALUES (CONCAT('upd ', OLD.id, ' ', OLD.n, '->', NEW.n, ' ', NEW.v))
q:UPDATE tr_t SET n = n + 1, v = 'x' WHERE id <= 2
q:SELECT * FROM tr_t ORDER BY id
q:UPDATE tr_t SET n = -1 WHERE id = 3
q:SELECT * FROM tr_t ORDER BY id
q:SELECT msg FROM tr_log ORDER BY k
q:CREATE TRIGGER tr_bd BEFORE DELETE ON tr_t FOR EACH ROW INSERT INTO tr_log (msg) VALUES (CONCAT('del ', OLD.id, ' ', OLD.v))
q:CREATE TRIGGER tr_ad AFTER DELETE ON tr_t FOR EACH ROW SET @deleted = IFNULL(@deleted, 0) + 1
q:SET @deleted = 0
q:DELETE FROM tr_t WHERE id >= 2
q:SELECT @deleted
