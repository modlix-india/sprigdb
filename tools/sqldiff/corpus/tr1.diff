q:CREATE TRIGGER tr_e6 BEFORE INSERT ON tr_t FOR EACH ROW SELECT 1
q:CREATE TRIGGER tr_e7 BEFORE INSERT ON nosuch_t FOR EACH ROW SET @q = 1
