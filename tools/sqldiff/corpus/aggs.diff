# Aggregates: STD/VARIANCE/BIT_*, GROUP_CONCAT with several arguments and ORDER BY.
x:DROP TABLE IF EXISTS ag_a
q:CREATE TABLE ag_a (id INT PRIMARY KEY, g VARCHAR(5), n INT, x DOUBLE, b INT UNSIGNED)
q:INSERT INTO ag_a VALUES (1,'p',3,1.5,5),(2,'p',1,2.5,3),(3,'q',4,NULL,12),(4,'q',NULL,4.0,10),(5,'r',9,9.0,NULL),(6,'p',1,0.5,1)
q:SELECT g, STD(n), STDDEV(n), STDDEV_POP(n), STDDEV_SAMP(n), VARIANCE(x), VAR_POP(x), VAR_SAMP(x) FROM ag_a GROUP BY g ORDER BY g
q:SELECT g, BIT_AND(b), BIT_OR(b), BIT_XOR(b) FROM ag_a GROUP BY g ORDER BY g
q:SELECT BIT_AND(b), BIT_OR(b), BIT_XOR(b), STD(n), VAR_SAMP(n) FROM ag_a WHERE id > 100
q:SELECT g, GROUP_CONCAT(n ORDER BY n), GROUP_CONCAT(n ORDER BY n DESC SEPARATOR ';'), GROUP_CONCAT(DISTINCT n ORDER BY n DESC) FROM ag_a GROUP BY g ORDER BY g
q:SELECT g, GROUP_CONCAT(id, ':', n ORDER BY id DESC), GROUP_CONCAT(id, n) FROM ag_a GROUP BY g ORDER BY g
q:SELECT GROUP_CONCAT(g ORDER BY x DESC, id) FROM ag_a
q:SELECT g, GROUP_CONCAT(id ORDER BY n, id) AS ids FROM ag_a GROUP BY g HAVING COUNT(*) > 1 ORDER BY g
q:SELECT VARIANCE(n) OVER () FROM ag_a WHERE id = 1
x:DROP TABLE IF EXISTS ag_a
