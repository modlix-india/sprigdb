# JSON_TABLE, MySQL-only forms: non-string DEFAULT refused, JSON DEFAULT text.
q:SELECT * FROM JSON_TABLE('[1]', '$[*]' COLUMNS (a INT PATH '$.z' DEFAULT 1 ON EMPTY)) jt
q:SELECT * FROM JSON_TABLE('[1]', '$[*]' COLUMNS (j JSON PATH '$.z' DEFAULT '{"x": 1}' ON EMPTY)) jt
q:SELECT * FROM JSON_TABLE('[1]', '$[*]' COLUMNS (a INT PATH '$.z' DEFAULT 'q' ON EMPTY)) jt
