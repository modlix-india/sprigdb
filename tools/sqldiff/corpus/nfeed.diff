q:SELECT id, (SELECT SUM(t.a) FROM JSON_TABLE(nf_j.doc, '$[*]' COLUMNS (a INT PATH '$.a')) AS t) AS s FROM nf_j ORDER BY id
q:SELECT t.s FROM JSON_TABLE('[{"s":"x"}]', '$[*]' COLUMNS (s VARCHAR(10) CHARACTER SET utf8mb4 PATH '$.s')) AS t
