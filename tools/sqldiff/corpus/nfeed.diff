q:CREATE TABLE nf_e (id INT PRIMARY KEY, st ENUM('a','b','it''s') NOT NULL, sn ENUM('x','y') NULL, s VARCHAR(5) COLLATE utf8mb4_bin)
q:INSERT INTO nf_e VALUES (1,'a','x','p'),(2,'b',NULL,'q')
q:SELECT st FROM nf_e UNION ALL SELECT st FROM nf_e ORDER BY 1
q:SELECT st FROM nf_e UNION ALL SELECT 'c'
q:SELECT 'c' AS st UNION ALL SELECT st FROM nf_e
q:SELECT nf_e.st AS k, sn FROM nf_e UNION SELECT 'a', NULL ORDER BY k
q:SELECT d.st FROM (SELECT st FROM nf_e WHERE id = 1 UNION ALL SELECT 'b' AS st) AS d ORDER BY d.st
q:SELECT st FROM nf_e WHERE id = 1 UNION ALL SELECT st FROM nf_e WHERE id = 2 UNION ALL SELECT 'z'
q:SELECT s FROM nf_e UNION ALL SELECT 'zz' ORDER BY 1
