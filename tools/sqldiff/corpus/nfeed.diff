q:CREATE TABLE nf_j (id INT PRIMARY KEY, doc JSON)
q:INSERT INTO nf_j VALUES (1,'[{"a":1,"s":"Ab"},{"a":2,"s":"cd"}]'),(2,'[{"a":3,"s":"ab"}]'),(3,'[]')
q:SELECT nf_j.id, t.a FROM nf_j, JSON_TABLE(nf_j.doc, '$[*]' COLUMNS (a INT PATH '$.a')) AS t ORDER BY nf_j.id, t.a
q:SELECT id FROM nf_j WHERE EXISTS (SELECT 1 FROM JSON_TABLE(nf_j.doc, '$[*]' COLUMNS (a INT PATH '$.a')) AS t WHERE t.a = 3)
