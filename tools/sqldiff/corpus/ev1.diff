q:CREATE EVENT ev_a ON SCHEDULE EVERY 2 HOUR STARTS '2030-01-01 00:00:00' + INTERVAL 1 DAY ENDS '2031-01-01' ON COMPLETION PRESERVE DISABLE COMMENT 'c''x' DO BEGIN INSERT INTO ev_log (msg) VALUES ('a'); END
