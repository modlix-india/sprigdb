# WITH RECURSIVE on engine databases: sequences, hierarchies, paths, UNION DISTINCT, several references, types.
x:DROP TABLE IF EXISTS rc_emp
q:CREATE TABLE rc_emp (id INT PRIMARY KEY, name VARCHAR(20) NOT NULL, boss INT, KEY (boss))
q:INSERT INTO rc_emp VALUES (1,'ann',NULL),(2,'bob',1),(3,'cid',1),(4,'dee',2),(5,'eve',4),(6,'fay',3),(7,'gus',NULL)
q:WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM c WHERE n<5) SELECT * FROM c
q:WITH RECURSIVE c AS (SELECT 1 AS n UNION ALL SELECT n+1 FROM c WHERE n<10) SELECT SUM(n), COUNT(*), MAX(n) FROM c
q:WITH RECURSIVE t AS (SELECT id, name, boss, 0 AS lvl FROM rc_emp WHERE boss IS NULL UNION ALL SELECT e.id, e.name, e.boss, t.lvl+1 FROM rc_emp e JOIN t ON e.boss = t.id) SELECT * FROM t ORDER BY lvl, id
q:WITH RECURSIVE t(id, path) AS (SELECT id, CAST(name AS CHAR(100)) FROM rc_emp WHERE id = 1 UNION ALL SELECT e.id, CONCAT(t.path, '/', e.name) FROM t JOIN rc_emp e ON e.boss = t.id) SELECT * FROM t ORDER BY path
q:WITH RECURSIVE up(id, boss) AS (SELECT id, boss FROM rc_emp WHERE id = 5 UNION ALL SELECT e.id, e.boss FROM rc_emp e, up WHERE e.id = up.boss) SELECT id FROM up ORDER BY id
q:WITH RECURSIVE c(n) AS (SELECT 1 UNION SELECT n % 3 + 1 FROM c) SELECT * FROM c ORDER BY n
q:WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT 7 UNION ALL SELECT n+1 FROM c WHERE n<3) SELECT * FROM c ORDER BY n
q:WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM c WHERE n<3) SELECT a.n, b.n FROM c a JOIN c b ON a.n = b.n ORDER BY 1
q:WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM c WHERE n<3) SELECT n, (SELECT COUNT(*) FROM c c2 WHERE c2.n <= c.n) FROM c ORDER BY n
q:SELECT (WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM c WHERE n<4) SELECT SUM(n) FROM c)
