# SHOW CREATE / SHOW STATUS / information_schema for routines; ALTER; definer-free probes.
x:DROP PROCEDURE IF EXISTS ss_p
x:DROP FUNCTION IF EXISTS ss_f
q:CREATE PROCEDURE ss_p(IN a INT, OUT b VARCHAR(10)) COMMENT 'it''s' READS SQL DATA SQL SECURITY INVOKER BEGIN SET b = a; END
q:CREATE FUNCTION ss_f(s CHAR(20), n int unsigned) RETURNS varchar(50) DETERMINISTIC NO SQL RETURN CONCAT(s, n)
q:SELECT ROUTINE_NAME, ROUTINE_TYPE, DATA_TYPE, CHARACTER_MAXIMUM_LENGTH, DTD_IDENTIFIER, ROUTINE_BODY, ROUTINE_DEFINITION, IS_DETERMINISTIC, SQL_DATA_ACCESS, SECURITY_TYPE, ROUTINE_COMMENT FROM information_schema.ROUTINES WHERE ROUTINE_SCHEMA = 'rsp_a' AND ROUTINE_NAME LIKE 'ss%' ORDER BY ROUTINE_NAME
q:SELECT SPECIFIC_NAME, ORDINAL_POSITION, PARAMETER_MODE, PARAMETER_NAME, DATA_TYPE, CHARACTER_MAXIMUM_LENGTH, NUMERIC_PRECISION, NUMERIC_SCALE, DTD_IDENTIFIER, ROUTINE_TYPE FROM information_schema.PARAMETERS WHERE SPECIFIC_SCHEMA = 'rsp_a' AND SPECIFIC_NAME LIKE 'ss%' ORDER BY SPECIFIC_NAME, ORDINAL_POSITION
q:SELECT COUNT(*) FROM information_schema.ROUTINES WHERE ROUTINE_SCHEMA = 'rsp_a' AND ROUTINE_NAME = 'ss_p'
