q:CREATE TRIGGER t2_hb BEFORE INSERT ON t2_h FOR EACH ROW SET NEW.y = CONCAT('h', NEW.x)
q:CREATE TRIGGER t2_hd BEFORE DELETE ON t2_h FOR EACH ROW SET @hd = CONCAT(IFNULL(@hd, ''), OLD.y)
