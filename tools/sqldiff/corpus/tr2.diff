q:CREATE PROCEDURE t2_p(IN d INT) UPDATE t2_b SET total = total + d WHERE id = 1
q:CREATE TRIGGER t2_ai AFTER INSERT ON t2_a FOR EACH ROW CALL t2_p(NEW.v)
q:CREATE TRIGGER t2_bu BEFORE UPDATE ON t2_b FOR EACH ROW SET NEW.total = LEAST(NEW.total, 100)
q:CREATE TRIGGER t2_ad AFTER DELETE ON t2_a FOR EACH ROW BEGIN DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET @err = 'caught'; INSERT INTO t2_b VALUES (1, 0); SET @after = OLD.id; END
