# Nested CALL, OUT through locals, recursion, runtime errors, transactions inside a procedure.
x:DROP PROCEDURE IF EXISTS sn_a
x:DROP PROCEDURE IF EXISTS sn_b
x:DROP PROCEDURE IF EXISTS sn_c
x:DROP PROCEDURE IF EXISTS sn_d
x:DROP PROCEDURE IF EXISTS sn_e
x:DROP FUNCTION IF EXISTS sn_f
x:DROP FUNCTION IF EXISTS sn_g
x:DROP TABLE IF EXISTS sn_t
x:CREATE TABLE sn_t (id INT PRIMARY KEY, v INT)
q:CREATE PROCEDURE sn_a(IN x INT, OUT y INT) BEGIN SET y = x * 10; END
q:CREATE PROCEDURE sn_b(IN n INT) BEGIN DECLARE r INT DEFAULT 0; CALL sn_a(n, r); SELECT r; CALL sn_a(r, @u); SELECT @u; END
q:CALL sn_b(4)
q:CREATE PROCEDURE sn_c() BEGIN CALL sn_c(); END
q:CALL sn_c()
q:CREATE PROCEDURE sn_d() BEGIN DECLARE x INT; SELECT id INTO x FROM sn_t; END
x:INSERT INTO sn_t VALUES (1, 1), (2, 2)
q:CALL sn_d()
q:CREATE FUNCTION sn_f(a INT) RETURNS INT BEGIN IF a > 0 THEN RETURN a; END IF; END
q:SELECT sn_f(5)
q:SELECT sn_f(-5)
q:CREATE PROCEDURE sn_e(k INT) BEGIN START TRANSACTION; INSERT INTO sn_t VALUES (k, k); IF k > 10 THEN ROLLBACK; ELSE COMMIT; END IF; SELECT COUNT(*) FROM sn_t; END
q:CALL sn_e(5)
q:CALL sn_e(50)
q:SELECT id, v FROM sn_t ORDER BY id
q:CREATE FUNCTION sn_g(a VARCHAR(5)) RETURNS VARCHAR(3) RETURN a
q:SELECT sn_g('ab'), sn_g(NULL)
q:SELECT sn_g('abcdef')
q:SELECT sn_f(1, 2)
q:CALL sn_a(1)
