# WITH RECURSIVE limits and errors, MySQL's.
q:WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM c WHERE n<1001) SELECT COUNT(*) FROM c
q:SHOW WARNINGS
q:SET @@cte_max_recursion_depth = 5
q:WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM c WHERE n<6) SELECT COUNT(*) FROM c
q:WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM c WHERE n<5) SELECT COUNT(*) FROM c
q:SET @@cte_max_recursion_depth = 0
q:WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM c WHERE n<1) SELECT COUNT(*) FROM c
q:SELECT @@cte_max_recursion_depth
q:SET @@cte_max_recursion_depth = DEFAULT
q:SELECT @@cte_max_recursion_depth
q:WITH RECURSIVE c(n) AS (SELECT 1 FROM c UNION ALL SELECT 1) SELECT COUNT(*) FROM c
q:WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM c WHERE n<3 UNION ALL SELECT n+10 FROM c WHERE n<3) SELECT * FROM c
q:WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM (SELECT * FROM c) d WHERE n<3) SELECT * FROM c
q:WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM c LIMIT 3) SELECT * FROM c
q:WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM c WHERE n<5 LIMIT 2, 2) SELECT * FROM c
q:WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT DISTINCT n+1 FROM c WHERE n<3) SELECT * FROM c
q:WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM c GROUP BY n HAVING n<3) SELECT * FROM c
q:WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT x.n+1 FROM (SELECT 1 AS k) z LEFT JOIN c x ON 1 WHERE x.n<3) SELECT * FROM c
q:WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT 'x' FROM c WHERE n<3) SELECT * FROM c
q:WITH RECURSIVE c(n) AS (SELECT 1 INTERSECT SELECT n+1 FROM c WHERE n<3) SELECT * FROM c
