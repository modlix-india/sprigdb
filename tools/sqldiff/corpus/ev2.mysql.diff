# SQL events that run (MySQL's scheduler is on): one-time with and without PRESERVE, a compound body, a repeating event with ENDS.
x:DROP EVENT IF EXISTS ev_once
x:DROP EVENT IF EXISTS ev_keep
x:DROP EVENT IF EXISTS ev_rep
x:DROP EVENT IF EXISTS ev_body
x:DROP TABLE IF EXISTS ev_run
x:CREATE TABLE ev_run (k INT AUTO_INCREMENT PRIMARY KEY, msg VARCHAR(100))
q:CREATE EVENT ev_once ON SCHEDULE AT CURRENT_TIMESTAMP DO INSERT INTO ev_run (msg) VALUES ('once')
q:CREATE EVENT ev_keep ON SCHEDULE AT CURRENT_TIMESTAMP ON COMPLETION PRESERVE DO INSERT INTO ev_run (msg) VALUES ('keep')
q:CREATE EVENT ev_rep ON SCHEDULE EVERY 1 SECOND ENDS CURRENT_TIMESTAMP + INTERVAL 2 SECOND DO INSERT INTO ev_run (msg) VALUES ('rep')
q:CREATE EVENT ev_body ON SCHEDULE AT CURRENT_TIMESTAMP + INTERVAL 1 SECOND DO BEGIN DECLARE i INT DEFAULT 0; WHILE i < 3 DO INSERT INTO ev_run (msg) VALUES (CONCAT('loop ', i)); SET i = i + 1; END WHILE; END
q:SELECT SLEEP(5)
q:SELECT msg FROM ev_run WHERE msg <> 'rep' ORDER BY msg
q:SELECT COUNT(*) BETWEEN 1 AND 3 FROM ev_run WHERE msg = 'rep'
q:SELECT EVENT_NAME, STATUS, LAST_EXECUTED IS NOT NULL FROM information_schema.EVENTS WHERE EVENT_SCHEMA = DATABASE() ORDER BY EVENT_NAME
x:DROP EVENT IF EXISTS ev_keep
x:DROP TABLE IF EXISTS ev_run
