# information_schema tables for engine objects: PARTITIONS (one row per unpartitioned table), and the stored-program tables read by tools.
x:DROP TABLE IF EXISTS isp_a
x:DROP VIEW IF EXISTS isp_v
x:DROP PROCEDURE IF EXISTS isp_p
x:DROP FUNCTION IF EXISTS isp_f
q:CREATE TABLE isp_a (id INT PRIMARY KEY, b INT, KEY(b))
q:CREATE VIEW isp_v AS SELECT id FROM isp_a
q:CREATE PROCEDURE isp_p(IN x INT, OUT y INT) SET y = x + 1
q:CREATE FUNCTION isp_f(x INT) RETURNS INT DETERMINISTIC RETURN x * 2
q:SELECT TABLE_NAME, PARTITION_NAME, PARTITION_ORDINAL_POSITION, PARTITION_METHOD, TABLE_ROWS, DATA_LENGTH, INDEX_LENGTH, PARTITION_COMMENT, NODEGROUP, TABLESPACE_NAME FROM information_schema.PARTITIONS WHERE TABLE_SCHEMA = 'rg_a' AND TABLE_NAME LIKE 'isp%' ORDER BY TABLE_NAME
q:SELECT COUNT(*) FROM information_schema.PARTITIONS WHERE TABLE_SCHEMA = 'rg_a' AND TABLE_NAME = 'isp_v'
q:SELECT ROUTINE_NAME, ROUTINE_TYPE, DATA_TYPE, ROUTINE_BODY, IS_DETERMINISTIC, SECURITY_TYPE FROM information_schema.ROUTINES WHERE ROUTINE_SCHEMA = 'rg_a' AND ROUTINE_NAME LIKE 'isp%' ORDER BY ROUTINE_NAME
q:SELECT SPECIFIC_NAME, ORDINAL_POSITION, PARAMETER_MODE, PARAMETER_NAME, DATA_TYPE, DTD_IDENTIFIER FROM information_schema.PARAMETERS WHERE SPECIFIC_SCHEMA = 'rg_a' AND SPECIFIC_NAME LIKE 'isp%' ORDER BY SPECIFIC_NAME, ORDINAL_POSITION
q:SELECT TABLE_NAME, IS_UPDATABLE, CHECK_OPTION FROM information_schema.VIEWS WHERE TABLE_SCHEMA = 'rg_a' AND TABLE_NAME LIKE 'isp%'
x:DROP FUNCTION isp_f
x:DROP PROCEDURE isp_p
x:DROP VIEW isp_v
x:DROP TABLE isp_a
